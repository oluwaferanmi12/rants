{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "jest",
      "node",
      "react",
      "react-native",
      "@types/styled-components",
      "@types/styled-components-react-native"
    ],
    "typeRoots": ["./node_modules/@types", "./@types"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.d.ts", "**/*.ts", "**/*.tsx", "**/*.test.tsx", "**/*.js", "styled-components.d.ts"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios"
  ]
}
